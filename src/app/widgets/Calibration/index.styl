.calibration {
  position: relative;
  padding: 10px;
  color: #333;
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 13px;
}

.headerBar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #ddd;
  margin-bottom: 10px;
  background-color: #f5f5f5;
  border-radius: 4px 4px 0 0;
}

.mainTabs {
  display: flex;
  flex: 1;
}

.mainTab {
  flex: 0 0 auto;
  background: transparent;
  border: 0;
  border-right: 1px solid #ddd;
  color: #337ab7;
  padding: 10px 15px;
  cursor: pointer;
  font-weight: normal;
  outline: 0;
}

.mainTab:hover:not(.activeTab) {
  background: #eee;
  color: #23527c;
}

.activeTab {
  background: #fff;
  color: #333;
  font-weight: bold;
  border-bottom: 1px solid #fff;
  margin-bottom: -1px;
  box-shadow: 0 -2px 0 #337ab7 inset;
}

.widgetContainer {
  display: flex;
  flex-direction: column;
}

.widgetContainer .panel + .panel,
.widgetContainer .stepRow + .panel {
  margin-top: 12px;
}

.panel {
  background-color: #fff;
  padding: 10px;
  border-radius: 4px;
  border: 1px solid #ddd;
  box-shadow: 0 1px 1px rgba(0, 0, 0, .05);
}

.panelHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.panelHeader h3 {
  margin: 0;
  font-size: 14px;
  font-weight: bold;
  color: #333;
}

.badgeOn,
.badgeOff,
.badgeWarn {
  padding: 2px 8px;
  border-radius: 4px;
  font-weight: bold;
  font-size: 12px;
}

.badgeOn {
  background: #dff0d8;
  color: #3c763d;
  border: 1px solid #d6e9c6;
}

.badgeOff {
  background: #f5f5f5;
  color: #777;
  border: 1px solid #ddd;
}

.badgeWarn {
  background: #fcf8e3;
  color: #8a6d3b;
  border: 1px solid #faebcc;
}

.metricGrid {
  display: flex;
  margin-left: -8px;
}

.metric {
  flex: 1 1 0;
  min-width: 0;
  margin-left: 8px;
  padding: 8px;
  background: #f9f9f9;
  border: 1px solid #eee;
  border-radius: 4px;
}

.metric span {
  display: block;
  color: #777;
  font-size: 11px;
  margin-bottom: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.metric strong {
  display: block;
  font-size: 14px;
  color: #333;
  overflow-wrap: anywhere;
}

.stepRow {
  display: flex;
  margin-left: -6px;
  margin-top: 12px;
}

.step,
.stepActive {
  flex: 1 1 0;
  min-width: 0;
  margin-left: 6px;
  padding: 8px;
  border: 1px solid #ddd;
  border-radius: 4px;
  background: #f7f7f7;
  color: #777;
}

.step strong,
.stepActive strong {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  margin-right: 6px;
  border-radius: 50%;
  background: #ddd;
  color: #555;
}

.stepActive {
  border-color: #337ab7;
  background: #eef6fc;
  color: #23527c;
}

.stepActive strong {
  background: #337ab7;
  color: #fff;
}

.presetRow {
  display: flex;
  margin: 0 0 10px -6px;
}

.preset,
.presetActive {
  margin-left: 6px;
  padding: 5px 10px;
  border: 1px solid #ccc;
  border-radius: 3px;
  background: #fff;
  color: #337ab7;
  cursor: pointer;
}

.presetActive {
  background: #337ab7;
  border-color: #2e6da4;
  color: #fff;
}

.formGrid {
  display: flex;
  flex-wrap: wrap;
  margin: -4px;
}

.field {
  display: flex;
  flex-direction: column;
  flex: 1 1 calc(50% - 8px);
  min-width: 130px;
  font-weight: normal;
  font-size: 11px;
  color: #777;
  margin: 4px;
}

.field span {
  margin-bottom: 3px;
}

.field input {
  display: block;
  width: 100%;
  height: 28px;
  padding: 3px 6px;
  font-size: 12px;
  color: #555;
  background-color: #fff;
  border: 1px solid #ccc;
  border-radius: 3px;
  box-shadow: inset 0 1px 1px rgba(0, 0, 0, .075);
  box-sizing: border-box;
}

.field input:focus {
  border-color: #66afe9;
  outline: 0;
  box-shadow: inset 0 1px 1px rgba(0, 0, 0, .075), 0 0 8px rgba(102, 175, 233, .6);
}

.field input.isInvalid {
  border-color: #a94442;
  background-color: #f2dede;
}

.buttonRow {
  display: flex;
  margin-top: 10px;
  align-items: stretch;
}

.buttonRow .btn + .btn {
  margin-left: 8px;
}

.btn {
  padding: 6px 12px;
  border: 1px solid transparent;
  border-radius: 4px;
  cursor: pointer;
  font-weight: 400;
  color: #fff;
  font-size: 13px;
  user-select: none;
}

.btnPrimary {
  background-color: #337ab7;
  border-color: #2e6da4;
}

.btnPrimary:hover {
  background-color: #286090;
  border-color: #204d74;
}

.btnSecondary {
  background-color: #5bc0de;
  border-color: #46b8da;
}

.btnSecondary:hover {
  background-color: #31b0d5;
  border-color: #269abc;
}

.btnSuccess {
  background-color: #5cb85c;
  border-color: #4cae4c;
}

.btnSuccess:hover {
  background-color: #449d44;
  border-color: #398439;
}

.btnDanger {
  background-color: #d9534f;
  border-color: #d43f3a;
}

.btnDanger:hover {
  background-color: #c9302c;
  border-color: #ac2925;
}

.btnExpand {
  flex: 1;
}

.buttonRow button:disabled {
  background-color: #eee;
  color: #aaa;
  cursor: not-allowed;
  border-color: #ddd;
}

.note,
.cutInstructions {
  margin-top: 8px;
  color: #777;
  font-size: 12px;
}

.cutInstructions div + div {
  margin-top: 4px;
}

.diagram {
  display: inline-block;
  margin: 0 0 10px;
  padding: 8px 12px;
  border: 1px solid #eee;
  border-radius: 4px;
  background: #f9f9f9;
  color: #555;
  font-family: Consolas, "Courier New", monospace;
  line-height: 1.4;
}

.resultDetails {
  margin-top: 10px;
  padding: 8px;
  border: 1px solid #eee;
  border-radius: 4px;
  background: #f9f9f9;
  color: #555;
  font-size: 12px;
}

.resultDetails div + div {
  margin-top: 3px;
}

.footerStatus {
  display: flex;
  align-items: center;
  margin-top: 8px;
  color: #777;
  font-size: 12px;
}

.footerStatus span:nth-child(2) {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 8px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}

@media (max-width: 520px) {
  .metricGrid {
    display: block;
    margin-left: 0;
  }

  .metric {
    margin-left: 0;
  }

  .metric + .metric {
    margin-top: 8px;
  }

  .field {
    flex-basis: calc(100% - 8px);
  }

  .buttonRow {
    flex-direction: column;
  }

  .buttonRow .btn + .btn {
    margin-left: 0;
    margin-top: 8px;
  }
}
