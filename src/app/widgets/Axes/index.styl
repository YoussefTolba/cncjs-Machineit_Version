@import "display-panel";
@import "rotate";
@import "keypad";

.widget-content {
    position: relative;
    padding: 10px;

    &.hidden {
        display: none;
    }
}

.row-space {
    margin-bottom: 5px;

    &:last-child {
        margin-bottom: 0;
    }
}
.col-space {
    margin-right: 5px;
}

.axis-homing-panel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 5px;
    margin: 5px 0;

    button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }
}
